# Copy to .env for local development. On Render, set these under Environment.

# ── Database ─────────────────────────────────────────────
DATABASE_URL=            # Postgres on Render; or DB_TYPE/DB_HOST/DB_PORT/DB_USERNAME/DB_PASSWORD/DB_NAME
DB_SYNC=true             # Postgres builds its schema from the entities
JWT_SECRET=
JWT_REFRESH_SECRET=
API_PUBLIC_URL=          # public backend URL, used in links and manual page images
FRONTEND_URL=

# ── AI ───────────────────────────────────────────────────
GROQ_API_KEY=            # free tier: chat + PDF scanning
OPENAI_API_KEY=          # optional: semantic search embeddings + image generation (paid)

# ── File storage ─────────────────────────────────────────
# Without R2, uploads live on local disk with a database backup (Render wipes the disk).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# ── Email (MailerSend preferred, SendGrid fallback) ──────
MAILERSEND_API_TOKEN=
MAILERSEND_LIST_UNSUBSCRIBE=false   # true only on MailerSend Professional/Enterprise
SENDGRID_API_KEY=
FROM_EMAIL=              # must be on a verified sending domain
FROM_NAME=Scana

# ── WhatsApp: Meta Cloud API (reminders, campaigns, job alerts) ──
WHATSAPP_TOKEN=          # permanent system-user token
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=   # any string; same value in Meta webhook settings
WHATSAPP_APP_SECRET=
WHATSAPP_TEMPLATE_LANG=en
# Optional Twilio fallback for technician job alerts
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# ── Browser push (generate with: npx web-push generate-vapid-keys) ──
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@scana.in
